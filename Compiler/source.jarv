void print(){
    __direct("lea rcx, [rel ifmt]");
    __direct("mov edx, eax");
    __direct("call printf");
}

int64 pow(int value, int exponent){
    int64 out = 1;
    for(int i = 0; i < exponent; i++){
        out *= value;
    }
    return out;
}


int main(){
    pow(2, 4);
    print();
    return 0;
}

